<?xml version="1.0" encoding="utf-8"?>
<!--
============================================================================
File: web.config
Project: SolariX - Smart Solar Microgrid Trading System
Module: Web API (The FAT Service)
Description: IIS configuration enabling hosting via the ASP.NET Core Module (In-Process hosting model).
============================================================================
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SolariX.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
