{
	"info": {
		"_postman_id": "solarix-complete-viva-test-suite",
		"name": "SolariX Smart Solar Microgrid — Complete Test Suite",
		"description": "Comprehensive API verification collection for SolariX SE4040 viva defense. Covers 3 User Logins, Station Management, Batch Slot Generation, 7-Day & 12-Hour Business Rules, Approval Lifecycle, and QR Verification.",
