	"item": [
		{
			"name": "1. Authentication (3 Distinct Roles)",
			"item": [
				{
					"name": "1.1 Login - Backoffice Administrator",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test('User is Backoffice Admin', function () {",
									"    pm.expect(data.role).to.eql('Backoffice');",
									"});",
									"pm.collectionVariables.set('adminToken', data.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"admin@solarix.com\",\n  \"password\": \"Admin@123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "1.2 Login - Grid Operator",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test('User is Grid Operator', function () {",
									"    pm.expect(data.role).to.eql('GridOperator');",
									"});",
									"pm.collectionVariables.set('operatorToken', data.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"operator@solarix.com\",\n  \"password\": \"Operator@123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "1.3 Login - Solar Prosumer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test('User is Prosumer', function () {",
									"    pm.expect(data.role).to.eql('Prosumer');",
									"});",
									"pm.collectionVariables.set('prosumerToken', data.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
